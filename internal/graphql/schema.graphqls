  plan: String!
}

type SubscriptionNotExistsDataType {
  plan: String!
}

type SubscriptionPlanNotFoundDataType {
  plan: String!
  recurring: String!
}

type SyncPermissionGenerationChangedDataType {
  spaceId: String!
}

type UnknownOauthProviderDataType {
  name: String!
}

type UnsupportedClientVersionDataType {
  clientVersion: String!
  requiredVersion: String!
}

type UnsupportedServerVersionDataType {
  requiredVersion: String!
}

type UnsupportedSubscriptionPlanDataType {
  plan: String!
}

type ValidationErrorDataType {
  errors: String!
}

type VersionRejectedDataType {
  serverVersion: String!
  version: String!
}

type WorkspacePermissionNotFoundDataType {
  spaceId: String!
}

type WrongSignInCredentialsDataType {
  email: String!
}

type Query {
  adminDashboard(input: AdminDashboardInput): AdminDashboard!
  error(name: ErrorNames!): ErrorDataUnion!
  prices: [SubscriptionPrice!]!
  adminMailDeliveries(
    input: AdminMailDeliveriesInput
  ): AdminMailDeliveryAnalytics!
  serverConfig: ServerConfigType!
  appConfig: JSONObject!
  appConfigMetadata: JSONObject!
  authSigningKeys: [AuthSigningKeyType!]!
  currentUser: UserType
  userById(id: String!): UserType!
  userByEmail(email: String!): UserType
  users(filter: ListUserInput!): [UserType!]!
  usersCount(filter: ListUserInput): Int!
  "get workspace invitation info"
  getInviteInfo(inviteId: String!): InvitationType!
  mcpCredentialReadWriteAvailable: Boolean!
  mcpCredentials(workspaceId: String!): [McpCredentialType!]!
  "Get public user by id"
  publicUserById(id: String!): PublicUserType
  user(email: String!): UserOrLimitedUser
  workspaces: [WorkspaceType!]!
  workspace(id: String!): WorkspaceType!
  "Get workspace role permissions"
  workspaceRolePermissions(id: String!): WorkspaceRolePermissions!
    @deprecated(reason: "use WorkspaceType[permissions] instead")
  adminWorkspaces(filter: ListWorkspaceInput!): [AdminWorkspace!]!
  adminWorkspacesCount(filter: ListWorkspaceInput!): Int!
  adminWorkspace(id: String!): AdminWorkspace
  adminAllSharedLinks(
    filter: AdminAllSharedLinksFilterInput
    pagination: PaginationInput!
  ): PaginatedAdminAllSharedLink!
  validateAppConfig(
    updates: [UpdateAppConfigInput!]!
  ): [AppConfigValidateResult!]!
}

type Copilot {
  workspaceId: String
  quota: CopilotQuota! @goField(forceResolver: true)
  routeOptions(promptName: String!): CopilotRouteOptions
    @goField(forceResolver: true)
  chats(
    pagination: PaginationInput!
    docId: String
    options: QueryChatHistoriesInput
  ): PaginatedCopilotHistoriesType! @goField(forceResolver: true)
  transcriptTask(blobId: String, taskId: String): TranscriptionResultType
    @goField(forceResolver: true)
}

enum AiJobStatus {
  claimed
  failed
  finished
  pending
  running
}

type TranscriptionItemType {
  end: String!
  speaker: String!
  start: String!
  transcription: String!
}

type AudioSliceManifestItemType {
  byteSize: Int
  durationSec: Float!
  fileName: String!
  index: Int!
  mimeType: String!
  startSec: Float!
}

input AudioSliceManifestItemInput {
  byteSize: Int
  durationSec: Float!
  fileName: String!
  index: Int!
  mimeType: String!
  startSec: Float!
}

type NormalizedTranscriptSegmentType {
  end: String!
  endSec: Float!
  speaker: String!
  start: String!
  startSec: Float!
  text: String!
}

type MeetingActionItemType {
  deadline: String
  description: String!
  owner: String
}

type MeetingSummaryV2Type {
  actionItems: [MeetingActionItemType!]!
  attendees: [String!]!
  blockers: [String!]!
  decisions: [String!]!
  durationMinutes: Float!
  keyPoints: [String!]!
  openQuestions: [String!]!
  title: String!
}

type TranscriptionQualityType {
  degraded: Boolean
  overflowCount: Int
}

input TranscriptionQualityInput {
  degraded: Boolean
  overflowCount: Int
}

type TranscriptionSourceAudioType {
  blobId: String
  channels: Int
  durationMs: Int
  mimeType: String
  sampleRate: Int
}

input TranscriptionSourceAudioInput {
  channels: Int
  durationMs: Int
  mimeType: String
  sampleRate: Int
}

input SubmitAudioTranscriptionInput {
  quality: TranscriptionQualityInput
  sliceManifest: [AudioSliceManifestItemInput!]
  sourceAudio: TranscriptionSourceAudioInput
}

type TranscriptionResultType {
  actions: String
  id: ID!
  normalizedSegments: [NormalizedTranscriptSegmentType!]
  normalizedTranscript: String
  quality: TranscriptionQualityType
  sliceManifest: [AudioSliceManifestItemType!]
  sourceAudio: TranscriptionSourceAudioType
  status: AiJobStatus!
  summary: String
  summaryJson: MeetingSummaryV2Type
  title: String
  transcription: [TranscriptionItemType!]
  version: String
}

type CopilotQuota {
  limit: SafeInt
  used: SafeInt!
}

type CopilotRouteTarget {
  id: String!
  displayName: String!
  minimumTier: String!
  available: Boolean!
}

type CopilotRouteOptions {
  routeId: String!
  defaultTargetId: String
  choices: [CopilotRouteTarget!]!
}

input QueryChatHistoriesInput {
  action: Boolean
  fork: Boolean
  pinned: Boolean
  limit: Int
  skip: Int
  messageOrder: ChatHistoryOrder
  sessionId: String
  withMessages: Boolean
  withPrompt: Boolean
  sessionOrder: ChatHistoryOrder
}

enum ChatHistoryOrder {
  asc
  desc
}

type CopilotHistories {
  sessionId: String!
  workspaceId: String!
  docId: String
  parentSessionId: String
  promptName: String!
  action: String
  pinned: Boolean!
  title: String
  messages: [ChatMessage!]!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type ChatMessage {
  id: ID
  role: String!
  content: String!
  attachments: [String!]
  scopeSnapshot: JSON
  streamObjects: [StreamObject!]
  createdAt: DateTime!
}

type StreamObject {
  type: String!
  textDelta: String
  toolCallId: String
  toolName: String
  args: JSON
  result: JSON
}

type CopilotHistoriesEdge {
  cursor: String!
  node: CopilotHistories!
}

type PaginatedCopilotHistoriesType {
  edges: [CopilotHistoriesEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

input CreateChatSessionInput {
  workspaceId: String!
  docId: String
  promptName: String!
  pinned: Boolean
  reuseLatestChat: Boolean
}

input UpdateChatSessionInput {
  sessionId: String!
  docId: String @goField(omittable: true)
  pinned: Boolean @goField(omittable: true)
  promptName: String @goField(omittable: true)
}

input DeleteSessionInput {
  workspaceId: String!
  docId: String
  sessionIds: [String!]!
}

input ForkChatSessionInput {
  workspaceId: String!
  docId: String!
  sessionId: String!
  latestMessageId: String
}

input CreateChatMessageInput {
  attachments: [String!] @deprecated(reason: "use blobs")
  blob: Upload
  blobs: [Upload!]
  content: String
  params: JSON
  sessionId: String!
}

type Mutation {
  addWorkspaceArtifact(
    blob: Upload!
    workspaceId: String!
  ): CopilotWorkspaceArtifact! @goField(forceResolver: true)
  removeWorkspaceArtifact(artifactId: String!, workspaceId: String!): Boolean!
    @goField(forceResolver: true)
  linkCalendarAccount(input: LinkCalendarAccountInput!): String!
    @goField(forceResolver: true)
  linkCalDAVAccount(input: LinkCalDAVAccountInput!): CalendarAccountObjectType!
    @goField(forceResolver: true)
  updateCalendarAccount(
    accountId: String!
    refreshIntervalMinutes: Int!
  ): CalendarAccountObjectType @goField(forceResolver: true)
  unlinkCalendarAccount(accountId: String!): Boolean!
    @goField(forceResolver: true)
  updateWorkspaceCalendars(
    input: UpdateWorkspaceCalendarsInput!
  ): WorkspaceCalendarObjectType! @goField(forceResolver: true)
  createCopilotSession(options: CreateChatSessionInput!): String!
  createCopilotSessionWithHistory(
    options: CreateChatSessionInput!
  ): CopilotHistories!
  updateCopilotSession(options: UpdateChatSessionInput!): String!
  cleanupCopilotSession(options: DeleteSessionInput!): [String!]!
  forkCopilotSession(options: ForkChatSessionInput!): String!
  createCopilotMessage(options: CreateChatMessageInput!): String!
    @goField(forceResolver: true)
  settleTranscriptTask(
    taskId: String!
    workspaceId: String!
  ): TranscriptionResultType @goField(forceResolver: true)
  submitTranscriptTask(
    blob: Upload
    blobs: [Upload!]
    blobId: String!
    input: SubmitAudioTranscriptionInput
    workspaceId: String!
  ): TranscriptionResultType @goField(forceResolver: true)
  retryTranscriptTask(
    taskId: String!
    workspaceId: String!
  ): TranscriptionResultType @goField(forceResolver: true)
  updateWorkspaceEmbeddingIgnoredDocs(
    add: [String!]
    remove: [String!]
    workspaceId: String!
  ): Int! @goField(forceResolver: true)
  updateAppConfig(updates: [UpdateAppConfigInput!]!): JSONObject!
  "Verify SMTP settings and send a test email to the current administrator"
  sendTestEmail(config: JSONObject!): Boolean!
  createCustomerPortal: String!
  createCheckoutSession(input: CreateCheckoutSessionInput!): String!
  cancelSubscription(
    idempotencyKey: String @deprecated(reason: "use header `Idempotency-Key`")
    plan: SubscriptionPlan = Pro
    workspaceId: String
  ): SubscriptionType!
  resumeSubscription(
    idempotencyKey: String @deprecated(reason: "use header `Idempotency-Key`")
    plan: SubscriptionPlan = Pro
    workspaceId: String
  ): SubscriptionType!
  updateSubscriptionRecurring(
    idempotencyKey: String @deprecated(reason: "use header `Idempotency-Key`")
    plan: SubscriptionPlan = Pro
    recurring: SubscriptionRecurring!
    workspaceId: String
  ): SubscriptionType!
  createMcpCredential(
    input: CreateMcpCredentialInput!
  ): RevealedMcpCredentialType!
  createWorkspaceByokProfile(
    input: CreateWorkspaceByokProfileInput!
  ): WorkspaceByokProfileType!
  replaceWorkspaceByokProfile(
    input: ReplaceWorkspaceByokProfileInput!
  ): WorkspaceByokProfileType!
  rotateWorkspaceByokCredential(
    input: RotateWorkspaceByokCredentialInput!
  ): WorkspaceByokProfileType!
  probeWorkspaceByokProfile(
    input: ProbeWorkspaceByokProfileInput!
