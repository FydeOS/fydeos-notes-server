scalar DateTime
scalar SafeInt
scalar Upload
scalar JSONObject
scalar JSON

directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

enum FeatureType {
  Admin
}

type LimitedUserType {
  email: String!
  hasPassword: Boolean
}

